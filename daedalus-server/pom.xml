<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.daedalus</groupId>
        <artifactId>daedalus-parent</artifactId>
        <version>1.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>daedalus-server</artifactId>
    <name>Daedalus :: Server (REST + WebSocket)</name>
    <description>
        Spring Boot host for Daedalus: REST controllers, WebSocket / STOMP,
        security, OpenAPI, observability. Optional module — engine + plugin
        runtime are usable without this layer.
    </description>

    <properties>
        <!-- Coverage ratchet: measured 95.10% instruction on 2026-08-02 (94.63% on 08-01, up
             from 82.2% on 07-29); re-pinned ~2 below. Raise as coverage rises; never lower to
             make a PR pass.

             The ceiling has now fired twice, which is the argument for keeping it. The Redis
             retention and round-trip tests pushed past 0.94 and failed the build until the
             last bump; the four tick/contract suites (traffic, living, campaign, generation)
             pushed past 0.95 and failed it again. Each time the build insisted the threshold
             move happen in the same commit as the tests that earned it, instead of banking
             slack the next regression could spend unnoticed. -->
        <jacoco.check.minimum>0.93</jacoco.check.minimum>
        <jacoco.check.ceiling>0.96</jacoco.check.ceiling>
    </properties>

    <dependencies>
        <!-- Daedalus stack — api + core + plugin-runtime are transitively pulled -->
        <dependency>
            <groupId>com.daedalus</groupId>
            <artifactId>daedalus-plugin-runtime</artifactId>
        </dependency>

        <!-- Spring Boot web stack -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            Brings in JWT support (JwtEncoder, JwtDecoder) backed by nimbus-jose-jwt.
            We use the resource-server stack as a self-hosted JWT issuer (HMAC-signed
            by an env-var secret), not as a downstream consumer of an external IDP.
            See JwtTokenService and ProdSecurityConfig.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- Resilience + caching. starter-aspectj is the missing half of
             @CircuitBreaker: resilience4j-spring-boot4 registers the aspect,
             but without AspectJ proxies the annotation is a no-op and
             generate() 500s instead of degrading to binary-tree. Rate
             limiters do not need this — they use a HandlerInterceptor.
             Boot 4 renamed the old starter-aop artifact. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Metrics -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger UI (Phase 5 of the handoff) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Lombok (optional) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.daedalus.server.DaedalusApp</mainClass>
                    <!--
                        Publish the executable fat JAR with a classifier so the thin JAR remains
                        the main artifact. Without this, downstream modules (daedalus-desktop)
                        can't compile against daedalus-server because the repackaged fat JAR
                        nests classes under BOOT-INF/classes/, which isn't on the compile
                        classpath. Run the executable with:
                            java -jar daedalus-server-<version>-exec.jar
                    -->
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
