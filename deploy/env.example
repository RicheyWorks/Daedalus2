# SPDX-License-Identifier: MIT
# Copy to .env (live) or staging.env and fill in. Never commit the filled copy (deploy/.gitignore).
# Secrets: run ./gen-secrets.sh >> .env  (REDIS_PASSWORD, DAEDALUS_JWT_SECRET, DAEDALUS_ADMIN_PASSWORD_BCRYPT).

# The public name players connect to (an A record pointing at this host). Unreal: DaedalusWorldActor ServerUrl.
DOMAIN=play.example.com
ACME_EMAIL=you@example.com

# Image tag, so a rollback is "set the old tag, up -d".
DAEDALUS_VERSION=local

# Server memory cap (the JVM takes DAEDALUS_HEAP_PERCENT of it).
DAEDALUS_SERVER_MEMORY=6g
DAEDALUS_HEAP_PERCENT=75

# Wallet sign-in + deeds (ADR-028). Testnet only (Sepolia 11155111). Mainnet needs Richey's explicit yes.
DAEDALUS_WALLET_ENABLED=false
DAEDALUS_WALLET_CHAIN_ID=11155111
DAEDALUS_WALLET_DEED_CONTRACT=
# A key with no funds that only signs mint vouchers. Set it on the host only.
DAEDALUS_WALLET_DEED_SIGNER_KEY=

BACKUP_EVERY_HOURS=6
BACKUP_KEEP_DAYS=14
