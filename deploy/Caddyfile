# TLS in front of the world server. Caddy gets and renews the certificate for {$DOMAIN} by itself.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# Overwrite (not append) the client address, so the server's per-player rate limits can trust it.
	reverse_proxy server:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
	# Only probes and metrics are public under /actuator; the server's prod security guards the rest.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output stdout
		format console
	}
}
