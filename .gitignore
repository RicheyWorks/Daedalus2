# Maven
target/
*/target/
*.jar

# JVM runtime artifacts (JaCoCo/agent attach files, crash logs)
.attach_pid*
*.attach_pid*
hs_err_pid*
replay_pid*

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Python (the mutation harness in mutants/)
__pycache__/
*.pyc

# Scratch source tarballs used to ship the tree to a build sandbox. _migration/ is TRACKED
# (165 archival files), not ignored, so an unignored tarball dropped here rides along on the
# next `git add -A` -- which is exactly how d2src-2026-07-31.tgz reached commit b7b4ecb.
_migration/*.tgz
_migration/*.tar.gz
