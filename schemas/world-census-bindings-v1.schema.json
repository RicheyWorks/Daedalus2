{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RicheyWorks/Daedalus2/main/schemas/world-census-bindings-v1.schema.json",
  "title": "Daedalus World Census Bindings v1",
  "description": "Optional explicit realm and asset-island bindings for the supplied manifest revisions. Omit an optional location to leave it unknown; explicit null locations are not accepted. The census validates referenced identities, revisions, slots, and duplicate bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "worlds"],
  "properties": {
    "format": {"const": "daedalus-world-census-bindings"},
    "version": {"type": "integer", "const": 1},
    "worlds": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["world_id", "revision"],
        "properties": {
          "world_id": {"$ref": "#/$defs/text"},
          "revision": {"$ref": "#/$defs/count"},
          "realm_id": {"$ref": "#/$defs/text"},
          "assets": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "file", "island_slot"],
              "properties": {
                "name": {"$ref": "#/$defs/text"},
                "file": {"$ref": "#/$defs/packagePath"},
                "island_slot": {"$ref": "#/$defs/count"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S", "not": {"pattern": "\\u0000"}},
    "count": {"type": "integer", "minimum": 0},
    "packagePath": {
      "$ref": "#/$defs/text",
      "allOf": [
        {"not": {"pattern": "^/"}},
        {"not": {"pattern": "[\\\\:]"}},
        {"not": {"pattern": "(^|/)\\.\\.?(/|(?![\\s\\S]))"}},
        {"not": {"pattern": "//"}},
        {"not": {"pattern": "/(?![\\s\\S])"}}
      ]
    }
  }
}
