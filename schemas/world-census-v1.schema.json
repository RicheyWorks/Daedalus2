{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RicheyWorks/Daedalus2/main/schemas/world-census-v1.schema.json",
  "title": "Daedalus World Census v1",
  "description": "An offline snapshot of exported asset definitions, not native instances or loaded assets. Null locations remain explicitly unknown or unassigned. Cross-reference and count consistency are enforced by the census implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "snapshot_date", "count_semantics", "bindings_sha256", "sources", "totals", "realms", "worlds"],
  "properties": {
    "format": {"const": "daedalus-world-census"},
    "version": {"type": "integer", "const": 1},
    "snapshot_date": {"type": "string", "minLength": 10, "maxLength": 10, "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "count_semantics": {"const": "asset-definitions"},
    "bindings_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sha256", "world_id", "revision"],
        "properties": {
          "sha256": {"$ref": "#/$defs/sha256"},
          "world_id": {"$ref": "#/$defs/text"},
          "revision": {"$ref": "#/$defs/count"}
        }
      }
    },
    "totals": {
      "type": "object", "additionalProperties": false,
      "required": ["worlds", "realms", "islands", "asset_definitions", "worlds_without_realm", "assets_without_realm", "assets_without_island"],
      "properties": {
        "worlds": {"$ref": "#/$defs/count"},
        "realms": {"$ref": "#/$defs/count"},
        "islands": {"$ref": "#/$defs/count"},
        "asset_definitions": {"$ref": "#/$defs/count"},
        "worlds_without_realm": {"$ref": "#/$defs/count"},
        "assets_without_realm": {"$ref": "#/$defs/count"},
        "assets_without_island": {"$ref": "#/$defs/count"}
      }
    },
    "realms": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "worlds", "islands", "asset_definitions"],
        "properties": {
          "id": {"$ref": "#/$defs/nullableText"},
          "worlds": {"$ref": "#/$defs/count"},
          "islands": {"$ref": "#/$defs/count"},
          "asset_definitions": {"$ref": "#/$defs/count"}
        }
      }
    },
    "worlds": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "style", "title", "seed", "revision", "realm_id", "islands", "assets", "asset_definitions", "assets_without_island", "source_sha256s"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "style": {"$ref": "#/$defs/text"},
          "title": {"$ref": "#/$defs/text"},
          "seed": {"type": "integer"},
          "revision": {"$ref": "#/$defs/count"},
          "realm_id": {"$ref": "#/$defs/nullableText"},
          "islands": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["slot", "asset_definitions"],
              "properties": {
                "slot": {"$ref": "#/$defs/count"},
                "asset_definitions": {"$ref": "#/$defs/count"}
              }
            }
          },
          "assets": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "file", "use", "island_slot"],
              "properties": {
                "name": {"$ref": "#/$defs/text"},
                "file": {"$ref": "#/$defs/packagePath"},
                "use": {"$ref": "#/$defs/text"},
                "island_slot": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]}
              }
            }
          },
          "asset_definitions": {"$ref": "#/$defs/count"},
          "assets_without_island": {"$ref": "#/$defs/count"},
          "source_sha256s": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S", "not": {"pattern": "\\u0000"}},
    "nullableText": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "count": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "packagePath": {
      "$ref": "#/$defs/text",
      "allOf": [
        {"not": {"pattern": "^/"}},
        {"not": {"pattern": "[\\\\:]"}},
        {"not": {"pattern": "(^|/)\\.\\.?(/|(?![\\s\\S]))"}},
        {"not": {"pattern": "//"}},
        {"not": {"pattern": "/(?![\\s\\S])"}}
      ]
    }
  }
}
