<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter. Add targeted <Match> blocks with a comment
  justifying each, rather than lowering the global threshold.
-->
<FindBugsFilter>
    <!--
      CT_CONSTRUCTOR_THROW warns that a throwing constructor on a non-final
      class enables a "finalizer attack" (subclass overrides finalize() to
      resurrect a partially-constructed object). Daedalus is not a security
      boundary, constructors validating their arguments is exactly what we
      want, and finalization itself has been deprecated for removal since
      Java 18. Excluded project-wide.
    -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
      The plugin API intentionally shares live engine objects with plugins:
      events hand listeners the actual MazeGrid / solution path (defensive
      copies per event would be both expensive and wrong — plugins are meant
      to observe the real object), and AbstractPlugin.context is a protected
      convenience field consumed by plugin subclasses that live outside this
      repository.
    -->
    <Match>
        <Package name="~com\.daedalus\.plugin.*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <!--
      MazeGraph is a live view: it must hold the caller's MazeGrid so carving
      after construction is visible. A defensive copy would be a snapshot,
      which is the opposite of the class.
    -->
    <Match>
        <Class name="com.daedalus.graph.MazeGraph"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      Replay copies on construct (EI_EXPOSE_REP2 is gone). Returning the
      unmodifiable List still flags EI_EXPOSE_REP; the detector only sees List.
    -->
    <Match>
        <Class name="com.daedalus.visualize.MazeReplay$Replay"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!--
      Constructor-injected Spring collaborators. Copying a singleton
      MazeGenerationService (or a JwtDecoder, MeterRegistry, RedisTemplate)
      is meaningless; SpotBugs cannot tell a @Service from a mutable DTO.
      Top-level service classes only — inner snapshot records stay visible.
    -->
    <Match>
        <Or>
            <Package name="com.daedalus.server.controller"/>
            <Package name="com.daedalus.server.health"/>
            <Class name="~com\.daedalus\.server\.service\.[A-Za-z0-9]+"/>
            <Class name="com.daedalus.server.security.JwtTokenService"/>
            <Class name="com.daedalus.desktop.ui.DesktopWork"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      ExploreWorld holds the live extruded snapshot (ADR-017). Copying the
      grid or mesh on every accessor would fork collision from the body.
      Unmodifiable hull/triangle lists still flag EI_EXPOSE_REP.
    -->
    <Match>
        <Or>
            <Class name="com.daedalus.explore.ExploreWorld"/>
            <Class name="com.daedalus.explore.ExploreMesh"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      The maze cache IS the live grid: living ticks, traffic, and solvers all
      mutate the same MazeGrid / MazeStats. Copying on get would fork the world.
    -->
    <Match>
        <Class name="com.daedalus.server.service.MazeGenerationService$Cached"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      MazeStats is a live accumulator filled during the solve. The Result
      holds that same instance so visited/explored stay the numbers the
      solver just wrote. A copy would be a second set of counters.
    -->
    <Match>
        <Class name="com.daedalus.server.service.MazeSolverService$Result"/>
        <Field name="stats"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      Distance / heuristic heatmaps are computed snapshots whose payload is an
      int[][]. Cloning on every accessor is O(cells); the record is discarded
      after the HTTP response.
    -->
    <Match>
        <Or>
            <Class name="com.daedalus.server.service.HeuristicLensService$Lens"/>
            <Class name="com.daedalus.server.service.TopographyService$DistanceField"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      JSON transport records and request snapshots. List.copyOf on construct
      stops the caller mutating the stored list (EI_EXPOSE_REP2). Returning
      the unmodifiable List still flags EI_EXPOSE_REP because the detector
      only sees the field type. A new mutable-list leak on session state
      (a non-record service field) is not covered here.
    -->
    <Match>
        <Or>
            <Package name="com.daedalus.api.dto"/>
            <Class name="~com\.daedalus\.server\.service\.[A-Za-z0-9]+\$[A-Za-z0-9]+"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!--
      DMI_RANDOM_USED_ONLY_ONCE on MazeBreeder.breed is a false positive: the single
      seeded Random drives the patch genome (a nextBoolean per block), the seam
      donor coin-flips (a nextBoolean per boundary edge), and the shuffle inside the
      connectivity repair — dozens to thousands of draws. The detector's heuristic
      appears to miss uses reached only through loops and a ternary. Crossbreeding
      must use exactly ONE Random for the whole operation, because determinism per
      (parentA, parentB, seed) is the documented contract and pinned by
      MazeBreederTest; splitting or re-seeding it would change every child.
    -->
    <Match>
        <Class name="com.daedalus.engine.MazeBreeder"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

    <!--
      Same false positive in LivingMazeService.drift: its seeded Random draws once per
      weighted cell inside a nested loop, and the per-tick seed is what makes erosion
      replayable. The detector misses uses reached only through loops.
    -->
    <Match>
        <Class name="com.daedalus.server.service.LivingMazeService"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

    <!--
      DaedalusApp and DaedalusLauncher keep a static
      ConfigurableApplicationContext so the desktop client can boot the server
      headless in-process and reach the context. MS_EXPOSE_REP flags the
      static accessors; the shared context is the feature, not an accident.
    -->
    <Match>
        <Or>
            <Class name="com.daedalus.server.DaedalusApp"/>
            <Class name="com.daedalus.desktop.DaedalusLauncher"/>
        </Or>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
