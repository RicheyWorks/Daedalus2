 "exit_row": 12,
 "npcs": [
  {
   "type": "Elder",
   "x": 8,
   "y": 8,
   "facing": "down",
   "lines": [
    "THIS IS WINDMERE. MY GRANDMOTHER'S GUILD OF SKIFF-WRIGHTS BUILT THE PRISM SKIFF THAT WAITS AT THE DOCK NORTH OF THE TOWN.",
    "ITS ENVELOPE ONLY FILLS WITH THE LIGHT OF A WARDEN'S SHARD. BEAT ONE AND IT WILL FLY FOR YOU."
   ],
   "request": {
    "id": "elder_carp",
    "item": "Sunscale Carp",
    "gold": 600,
    "ask": "MY HUSBAND USED TO BRING ME A SUNSCALE CARP EVERY SPRING. IF THE POND EVER GIVES YOU ONE, I WOULD PAY WELL FOR IT.",
    "offer": "IS THAT A SUNSCALE CARP? WILL YOU GIVE IT TO AN OLD WOMAN?",
    "thanks": "IT IS STILL WARM. THANK YOU. TAKE THIS GOLD; HE WOULD HAVE WANTED IT SPENT ON ADVENTURES.",
    "done": "I COOKED IT THE WAY HE DID. THE WHOLE VILLAGE SMELLED OF SPRING."
   }
  },
  {
   "type": "Farmer",
   "x": 11,
   "y": 10,
   "facing": "left",
   "lines": [
    "FROM THE HILL YOU CAN SEE A VALLEY IN THE MIDDLE OF THE MOUNTAINS. NO ROAD GOES IN. NOBODY HAS EVER WALKED THERE."
   ]
  },
  {
   "type": "Child",
   "x": 4,
   "y": 6,
   "facing": "down",
   "lines": [
    "I CLIMBED THE ROOF AND SAW THINGS SHINING WHERE THERE ARE NO ROADS. GRANDPA SAYS ONLY BIRDS AND SKIFFS GET THERE."
   ]
  },
  {
   "type": "Sailor",
   "x": 4,
   "y": 9,
   "facing": "left",
   "lines": [
    "A SKIFF IS NOT A BOAT. IT FLIES OVER PEAKS AND SEA AT TWICE A WALKER'S PACE.",
    "PRESS A TO SET IT DOWN, BUT ONLY ON OPEN GROUND. NOT ON A MOUNTAIN, NOT ON THE WATER.",
    "AND THE POND? FULL OF FISH. STAND ON THE BANK, FACE THE WATER AND PRESS A. STRIKE WHEN YOU SEE THE FLOAT JUMP."
   ]
  },
  {
   "type": "Mage",
   "x": 12,
   "y": 5,
   "facing": "down",
   "lines": [
    "THE MONSTERS AVOID WINDMERE. THE OLD WARD-STONES STILL HUM UNDER THE FIELDS."
   ]
  }
 ]
