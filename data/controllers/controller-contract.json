{
 "schema": "daedalus.controller-contract/1",
 "frozen": true,
 "coordinates": "stick y is up-positive (Unreal convention); axes and triggers in [-1, 1] / [0, 1]",
 "logical": [
  "up",
  "down",
  "left",
  "right",
  "confirm",
  "cancel",
  "menu"
 ],
 "rules": {
  "confirm": "layout 'south' (Xbox, PlayStation, Sega, arcade ...): south confirms, east goes back. layout 'east' (Nintendo-style by label, the Menu Confirm Button row's BY LABEL): east confirms, south goes back.",
  "aliases": "a logical action is held while ANY source holds it; releasing one source never releases an action another source still holds.",
  "digital_stick": {
   "press": 0.55,
   "release": 0.4,
   "switch_bias": 0.1,
   "rule": "one cardinal at a time. Press when the larger axis reaches 0.55. Hold while the held direction's own signed component stays above 0.40 (0.40 exactly releases). Switch to a different cardinal only when the larger axis reaches 0.55 and exceeds the held component by more than 0.10. A flick to the opposite side switches at once."
  },
  "release_all": "focus loss, disconnect and exit release every held action.",
  "repeats": "an OS key repeat never produces a second press.",
  "analog": {
   "center_deadzone": "radial, rescaled: (|v| - dz) / (max - dz), direction kept (no cross-shaped dead zone)",
   "max_input": "the magnitude that already counts as full",
   "axial": "after radial, a component below it is zeroed",
   "triggers": "(t - inner) / (outer - inner), clamped to [0, 1]; pressed above 0.5",
   "defaults": {
    "center": 0.15,
    "max": 1.0,
    "axial": 0.0,
    "trigger_inner": 0.05,
    "trigger_outer": 0.95
   }
  },
  "one_button": "a device with no second button: release before 350 ms = confirm, release after = cancel, still held at 1200 ms = menu.",
  "no_start": "a device with no start: back opens the menu, or south + east together."
 },
