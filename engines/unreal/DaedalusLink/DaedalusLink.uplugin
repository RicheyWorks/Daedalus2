{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.32.0",
	"FriendlyName": "Daedalus Link",
	"Description": "Stream a live Daedalus world (islands, arks, sky gates past the rainbow) into Unreal Engine 5, or import a Daedalus World Package. Generate a world once; deploy it to any engine.",
	"Category": "Daedalus",
	"CreatedBy": "RicheyWorks",
	"CreatedByURL": "https://github.com/RicheyWorks/Daedalus2",
	"DocsURL": "https://github.com/RicheyWorks/Daedalus2/blob/main/engines/unreal/README.md",
	"SupportURL": "https://github.com/RicheyWorks/Daedalus2/issues",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"Installed": false,
	"Modules": [
		{
			"Name": "DaedalusLink",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64",
				"Mac",
				"Linux"
			]
		}
	],
	"Plugins": [
		{
			"Name": "ProceduralMeshComponent",
			"Enabled": true
		},
		{
			"Name": "EnhancedInput",
			"Enabled": true
		}
	]
}
