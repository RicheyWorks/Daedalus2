# chain/.env — never commit the real file. Testnet only.
# A throwaway key that holds only Sepolia test ETH. It deploys the contract and owns it.
DEPLOYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The realm's deed-signer ADDRESS (not key): the server logs it at boot
# ("Island deed vouchers are signed by 0x…").
REALM_SIGNER=
# Where the realm serves token metadata, ending in a slash.
REALM_BASE_URI=https://your-realm.example/api/v1/world/world-zero/tokens/
# Optional: the contract's owner, if not the deployer (e.g. a Safe).
REALM_OWNER=
# Fee guard (same as fast-food-punks-token): refuse any tx whose worst case is above this.
DEPLOY_MAX_TX_FEE_ETH=0.002
ETHERSCAN_API_KEY=
