{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RicheyWorks/Daedalus2/docs/contracts/brew-melody-v1/brew-melody-v1.schema.json",
  "title": "brew-melody-v1: POST /api/v1/brew/melody",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["herbs"],
      "properties": {
        "herbs": {"type": "array", "minItems": 3, "maxItems": 5, "description": "Ordered island herb ids (case-insensitive): Doleaf, Sharpcress, Rebell, Flatfern, Mimint, Fasage, Hushmoss, Solthorn, Gloryroot, Lavine, Dronebloom, Tisquill",
          "items": {"type": "string", "enum": ["Doleaf", "Sharpcress", "Rebell", "Flatfern", "Mimint", "Fasage", "Hushmoss", "Solthorn", "Gloryroot", "Lavine", "Dronebloom", "Tisquill"]}},
        "stages": {"type": "array", "description": "Growth stage per herb, same length as herbs; default 3 each", "items": {"type": "integer", "minimum": 1, "maximum": 4}},
        "records": {"type": "array", "maxItems": 32, "description": "Record item ids the player has played (playRecord); a matching herb order then yields that found tune", "items": {"type": "string", "pattern": "^Item_YTM_Record_[A-Za-z]+$"}}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "cadence", "contour", "quality", "tier", "effect", "magnitude", "durationS", "notes", "foundTune", "foundTuneBonus", "recordId", "why"],
      "properties": {
        "item": {"type": "string", "description": "Tonic item id to grant (found-tune tonic when matched)"},
        "cadence": {"type": "boolean", "description": "Last note = first; the tonic purifies water"},
        "contour": {"type": "string", "enum": ["Rise", "Fall", "Arch", "Valley", "Dance", "Noise"]},
        "quality": {"type": "string", "enum": ["Aug", "Dim", "Major", "Minor", "Sus", "Seventh", "Noise"]},
        "tier": {"type": "integer", "minimum": 1, "maximum": 4},
        "effect": {"type": "string"},
        "magnitude": {"type": "integer", "minimum": 0},
        "durationS": {"type": "integer", "minimum": 0},
        "notes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 11}},
        "foundTune": {"type": ["string", "null"]},
        "foundTuneBonus": {"type": ["string", "null"]},
        "recordId": {"type": ["string", "null"], "description": "learnedFrom record of the matched found tune"},
        "why": {"type": "string", "description": "Why a brew is Noise; empty otherwise"}
      }
    }
  }
}
