{
  "contract": "photo-pdf-v1",
  "objectType": "photo-pdf-machine",
  "unrealClass": "ADaedalusPhotoPdfMachine",
  "nativeLaunchPlatforms": ["Windows"],
  "interactionSeam": "ADaedalusUsable.Use",
  "app": {
    "repository": "RicheyWorks/PhotosToPDF",
    "module": "PhotosToPDFPC",
    "originalService": "com.photostopdfpc.service.PdfConversionService",
    "optInArgument": "--realm-bridge"
  },
  "pairing": {
    "transport": "local-loopback",
    "urlShape": "http://127.0.0.1:<port>/#token=<capability>",
    "persistent": false,
    "replicated": false,
    "permissions": "local-player-interaction"
  },
  "capabilities": ["select-images", "convert-to-individual-pdfs", "download", "cancel", "delete"],
  "conversion": {
    "output": "one-single-page-pdf-per-image",
    "pageSize": "image-pixel-dimensions",
    "inputTypes": ["PNG", "JPEG"],
    "pathInput": false,
    "externalUpload": false,
    "merge": false
  },
  "defaultLimits": {
    "images": 8,
    "bytesPerImage": 8388608,
    "bytesPerBatch": 25165824,
    "dimension": 4096,
    "pixelsPerImage": 12000000,
    "pixelsPerBatch": 24000000,
    "sessions": 4,
    "retainedJobs": 16,
    "workerThreads": 1,
    "queuedJobs": 2,
    "retentionSeconds": 900
  },
  "outOfScope": ["real-fax-transmission", "ocr", "physical-printing", "nft-minting", "license-changes", "provider-billing"],
  "acceptance": {
    "nativePlacementOwner": "unreal-team",
    "physicalArtOwnerRequested": "blender-team",
    "bridgeOwner": "pootscoot-practical-apps",
    "liveAccepted": false,
    "ownerAcknowledgmentRequired": true
  }
}
