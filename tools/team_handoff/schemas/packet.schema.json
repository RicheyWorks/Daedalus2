{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daedalus offline takeover packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checkpoint", "files"],
  "properties": {
    "schema": {"const": "daedalus.takeover-packet.v1"},
    "checkpoint": {"$ref": "checkpoint.schema.json"},
    "files": {
      "type": "object",
      "maxProperties": 7,
      "propertyNames": {
        "type": "string",
        "maxLength": 220,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
        }
      }
    }
  },
  "$comment": "Python validation additionally requires exact evidence-role inventory, portable noncolliding paths, total-size limit, content digests and supported provenance/boundary semantics. This is the sealed manifest shape; read_packet adds sha256 and selection to its in-memory result."
}
