{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daedalus retained build-time provenance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recorded_at_build_time", "source_commit", "inputs_before_sha256", "inputs_after_sha256", "artifact_sha256", "toolchain", "command", "exit_code"],
  "properties": {
    "schema": {"const": "daedalus.build-provenance.v1"},
    "recorded_at_build_time": {"const": true},
    "source_commit": {"type": "string", "minLength": 1, "maxLength": 4096},
    "inputs_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "compiler"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "compiler": {"type": "string", "minLength": 1}
      }
    },
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "exit_code": {"const": 0, "type": "integer"}
  },
  "$comment": "Python validation additionally binds source commit and before/after input digests to the retained input manifest, and artifact to checkpoint/runtime pins. Build-time capture truth is a producer attestation, never inferred from current files."
}
