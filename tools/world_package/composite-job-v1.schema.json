{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.invalid/schemas/world-package-composite-job-v1",
  "title": "Frozen World Package composite manifest",
  "description": "Structural pins only. Runtime verifies inventory, budgets, child plans, receipt union, mapping and the aggregate job. No native acceptance or receipt authenticity is conferred.",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "state", "files", "native_acceptance"],
  "properties": {
    "format": {"const": "daedalus-world-composite-job"},
    "version": {"type": "integer", "const": 1},
    "state": {"const": "complete"},
    "native_acceptance": {"const": false},
    "files": {
      "type": "array", "minItems": 6, "maxItems": 66,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(lineage\\.json|aggregate/job\\.json|children/[0-9]{4}/(job\\.json|provenance\\.json|request\\.json|plan\\.json))$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "allOf": [
          {"if": {"properties": {"path": {"pattern": "job\\.json$"}}}, "then": {"properties": {"bytes": {"maximum": 65536}}}},
          {"if": {"properties": {"path": {"pattern": "provenance\\.json$"}}}, "then": {"properties": {"bytes": {"maximum": 2097152}}}},
          {"if": {"properties": {"path": {"pattern": "(lineage|request)\\.json$"}}}, "then": {"properties": {"bytes": {"maximum": 1048576}}}}
        ]
      }
    }
  }
}
