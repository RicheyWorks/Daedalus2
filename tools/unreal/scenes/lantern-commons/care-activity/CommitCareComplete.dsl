(fn CommitCareComplete ()
  (if (Variables|Default|GetLoadBlocked) (return))
  (if (Variables|Default|GetCareComplete) (return))
  (if (!= (Variables|Default|GetGardenStage) 2) (return))
  (if (Variables|Default|GetHasWater)
    (Class|SGCommonsGarden|SetCareComplete :self (Variables|Default|GetGardenSave) :CareComplete true)
    (if (SaveGame|SaveGametoSlot :SaveGameObject (Variables|Default|GetGardenSave) :SlotName "Daedalus_LanternCommons_Garden_v1" :UserIndex 0)
      (Variables|Default|SetCareComplete true)
      (Variables|Default|SetHasWater false)
      (Variables|Default|SetSaveFailed false)
      (else
        (Class|SGCommonsGarden|SetCareComplete :self (Variables|Default|GetGardenSave) :CareComplete (Variables|Default|GetCareComplete))
        (Variables|Default|SetSaveFailed true))))
  (CallFunction|RefreshGarden))