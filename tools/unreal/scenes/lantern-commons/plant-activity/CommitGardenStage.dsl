(fn CommitGardenStage (NewStage)
  (if (Variables|Default|GetLoadBlocked) (return))
  (Class|SGCommonsGarden|SetGardenStage :self (Variables|Default|GetGardenSave) :GardenStage NewStage)
  (if (SaveGame|SaveGametoSlot :SaveGameObject (Variables|Default|GetGardenSave) :SlotName "Daedalus_LanternCommons_Garden_v1" :UserIndex 0)
    (Variables|Default|SetGardenStage NewStage)
    (Variables|Default|SetSaveFailed false)
    (else
      (Class|SGCommonsGarden|SetGardenStage :self (Variables|Default|GetGardenSave) :GardenStage (Variables|Default|GetGardenStage))
      (Variables|Default|SetSaveFailed true)))
  (CallFunction|RefreshGarden))