{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.invalid/schemas/build-capture-request-v1.schema.json",
  "title": "Explicit offline build capture request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_commit", "toolchain", "command", "inputs", "artifact", "timeout_seconds", "notes"],
  "properties": {
    "schema": {"const": "daedalus.build-capture-request.v1"},
    "source_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "compiler"],
      "properties": {"engine": {"$ref": "#/$defs/text"}, "compiler": {"$ref": "#/$defs/text"}}
    },
    "command": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/text"}},
    "inputs": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "kind", "category"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "kind": {"enum": ["file", "directory"]},
          "category": {"enum": ["source", "header", "descriptor", "config", "generated"]}
        }
      }
    },
    "artifact": {"$ref": "#/$defs/path"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "notes": {"type": "object", "description": "Opaque original annotations, including null unknowns; never interpreted as build facts."}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f]+$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 220, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"}
  },
  "$comment": "The stdlib validator additionally requires finite UTF-8 JSON, max64KiB raw/canonical request, nonzero commit, portable nonreserved path components, distinct nonoverlapping case-consistent roots, artifact separation, nonblank strings and max16384 argv characters. Supplied commit/toolchain are declarations, not verified facts. No caller-supplied outcome or timestamps."
}
