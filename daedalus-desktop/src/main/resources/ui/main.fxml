<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<!--
    Main desktop layout. Three regions:

      - top:    compact toolbar (generator, grid, seed, Generate, solver)
      - center: canvas pane; legend overlays the well and does not steal height
      - bottom: status bar (last action + timing)

    Controller is wired by Spring (DaedalusPrimaryStage's controller factory).
    The canvas itself doesn't auto-resize — MainController sizes the
    backing store to the pane times the window output scale and redraws.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.daedalus.desktop.ui.MainController"
            styleClass="root">

    <top>
        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="toolbar">
            <padding>
                <Insets top="6" right="8" bottom="6" left="8"/>
            </padding>

            <ComboBox fx:id="generatorChoice" prefWidth="88" maxWidth="88">
                <tooltip><Tooltip text="Generator"/></tooltip>
            </ComboBox>

            <Spinner fx:id="rowsSpinner" prefWidth="58" editable="true">
                <tooltip><Tooltip text="Rows"/></tooltip>
            </Spinner>
            <Spinner fx:id="colsSpinner" prefWidth="58" editable="true">
                <tooltip><Tooltip text="Cols"/></tooltip>
            </Spinner>
            <Spinner fx:id="hotspotSpinner" prefWidth="46" editable="true">
                <tooltip><Tooltip text="Hot spots"/></tooltip>
            </Spinner>
            <Spinner fx:id="hotspotCostSpinner" prefWidth="50" editable="true">
                <tooltip><Tooltip text="Spot cost"/></tooltip>
            </Spinner>
            <ComboBox fx:id="braidChoice" prefWidth="56" maxWidth="56">
                <tooltip><Tooltip text="Braid"/></tooltip>
            </ComboBox>

            <Separator orientation="VERTICAL"/>

            <TextField fx:id="seedField" prefWidth="52" promptText="seed">
                <tooltip><Tooltip text="Seed (blank = random)"/></tooltip>
            </TextField>

            <Button fx:id="generateButton"
                    text="Generate"
                    defaultButton="true"
                    onAction="#onGenerate"/>

            <Separator orientation="VERTICAL"/>

            <ComboBox fx:id="solverChoice" prefWidth="80" maxWidth="80">
                <tooltip><Tooltip text="Solver"/></tooltip>
            </ComboBox>
            <Button fx:id="solveButton" text="Solve" onAction="#onSolve"/>
            <Button fx:id="resetButton" text="Reset" onAction="#onReset"/>
            <CheckBox fx:id="fogToggle" text="Fog" onAction="#onFog">
                <tooltip><Tooltip text="Fog of war — walk reveals the dungeon"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="heatToggle" text="Heat" onAction="#onHeat">
                <tooltip><Tooltip text="Distance from the goal"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="cutsToggle" text="Cuts" onAction="#onCuts">
                <tooltip><Tooltip text="Min-cut chokepoints and dead ends"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="hardestToggle" text="Long" onAction="#onHardest">
                <tooltip><Tooltip text="Hardest simple route"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="sanctuaryToggle" text="Safe" onAction="#onSanctuaries">
                <tooltip><Tooltip text="Sanctuaries — k-center safe points"/></tooltip>
            </CheckBox>
            <ComboBox fx:id="lensChoice" prefWidth="64" maxWidth="64" onAction="#onLens">
                <tooltip><Tooltip text="Heuristic lens — must / tie / never"/></tooltip>
            </ComboBox>
            <CheckBox fx:id="raceToggle" text="Race" onAction="#onRace">
                <tooltip><Tooltip text="Selected solver vs a rival, same arena as the web"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="huntToggle" text="Hunt" onAction="#onHunt">
                <tooltip><Tooltip text="Waypoint hunt — collect the coins"/></tooltip>
            </CheckBox>
        </HBox>
    </top>

    <center>
        <Pane fx:id="canvasParent" styleClass="canvas-pane">
            <Canvas fx:id="canvas"/>
            <HBox fx:id="legendBox" spacing="14" alignment="CENTER" styleClass="legend"
                  managed="false" mouseTransparent="true" visible="false">
                <Label text="floor">
                    <graphic>
                        <Rectangle width="10" height="10" fill="#3d4a58" arcWidth="3" arcHeight="3"/>
                    </graphic>
                </Label>
                <Label text="wall / rock">
                    <graphic>
                        <Rectangle width="10" height="10" fill="#0b0f14"
                                   stroke="#1e2832" arcWidth="3" arcHeight="3"/>
                    </graphic>
                </Label>
                <Label fx:id="legendStart" text="start">
                    <graphic>
                        <Circle radius="5" fill="#3ee08f"/>
                    </graphic>
                </Label>
                <Label fx:id="legendGoal" text="goal">
                    <graphic>
                        <Circle radius="5" fill="#ff5a5f"/>
                    </graphic>
                </Label>
                <Label fx:id="legendPath" text="solver path" managed="false" visible="false">
                    <graphic>
                        <Rectangle width="10" height="10" fill="#8fb8ff" arcWidth="3" arcHeight="3"/>
                    </graphic>
                </Label>
                <Label fx:id="legendPlayer" text="walk" managed="false" visible="false">
                    <graphic>
                        <Circle radius="5" fill="#f5c14a"/>
                    </graphic>
                </Label>
                <Label fx:id="legendHotspot" text="hot spot" managed="false" visible="false">
                    <graphic>
                        <Rectangle width="10" height="10" fill="#e5484d" opacity="0.5"
                                   arcWidth="3" arcHeight="3"/>
                    </graphic>
                </Label>
                <Label fx:id="legendFog" text="unseen (fog)" managed="false" visible="false">
                    <graphic>
                        <Rectangle width="10" height="10" fill="#05070a"
                                   stroke="#1e2832" arcWidth="3" arcHeight="3"/>
                    </graphic>
                </Label>
                <Label fx:id="legendChoke" text="chokepoint" managed="false" visible="false">
                    <graphic>
                        <Rectangle width="10" height="10" fill="#c084fc" arcWidth="3" arcHeight="3"/>
                    </graphic>
                </Label>
                <Label fx:id="legendHardest" text="hardest" managed="false" visible="false">
                    <graphic>
                        <Rectangle width="10" height="10" fill="#f2c94c" arcWidth="3" arcHeight="3"/>
                    </graphic>
                </Label>
                <Label fx:id="legendSanctuary" text="sanctuary" managed="false" visible="false">
                    <graphic>
                        <Circle radius="5" fill="#4cc38a"/>
                    </graphic>
                </Label>
                <Label fx:id="legendLens" text="lens" managed="false" visible="false">
                    <graphic>
                        <HBox spacing="1">
                            <Rectangle width="6" height="10" fill="#e5484d"/>
                            <Rectangle width="6" height="10" fill="#f2c94c"/>
                            <Rectangle width="6" height="10" fill="#4cc38a"/>
                        </HBox>
                    </graphic>
                </Label>
                <Label fx:id="legendRace" text="arena" managed="false" visible="false">
                    <graphic>
                        <HBox spacing="1">
                            <Rectangle width="6" height="10" fill="#82b1ff"/>
                            <Rectangle width="6" height="10" fill="#f0b429"/>
                        </HBox>
                    </graphic>
                </Label>
                <Label fx:id="legendWaypoint" text="waypoint" managed="false" visible="false">
                    <graphic>
                        <Rectangle width="8" height="8" fill="#f2c94c" rotate="45"/>
                    </graphic>
                </Label>
                <Label fx:id="legendGhost" text="ghost" managed="false" visible="false">
                    <graphic>
                        <Circle radius="5" fill="#e6edf3" opacity="0.6"/>
                    </graphic>
                </Label>
                <Label fx:id="legendCompare" text="compare" managed="false" visible="false">
                    <graphic>
                        <HBox spacing="1">
                            <Rectangle width="6" height="10" fill="#8fb8ff"/>
                            <Rectangle width="6" height="10" fill="#f0b429"/>
                            <Rectangle width="6" height="10" fill="#e5484d"/>
                        </HBox>
                    </graphic>
                </Label>
            </HBox>
            <HBox fx:id="exportBox" spacing="8" alignment="CENTER_RIGHT" styleClass="exports"
                  managed="false" visible="false">
                <CheckBox fx:id="liveToggle" text="Live" onAction="#onLive">
                    <tooltip><Tooltip text="Bring the maze to life — same erosion ticks as the web"/></tooltip>
                </CheckBox>
                <CheckBox fx:id="hardToggle" text="Hard">
                    <tooltip><Tooltip text="Harden — close extra passages each Live tick (ADR-008)"/></tooltip>
                </CheckBox>
                <CheckBox fx:id="jamToggle" text="Jam" onAction="#onJam">
                    <tooltip><Tooltip text="Simulate traffic — walked cells bloom cost, then cool off"/></tooltip>
                </CheckBox>
                <CheckBox fx:id="allToggle" text="All" onAction="#onAll">
                    <tooltip><Tooltip text="Compare all solvers — overlapping routes are consensus"/></tooltip>
                </CheckBox>
                <Button fx:id="pngButton" text="PNG" onAction="#onExportPng">
                    <tooltip><Tooltip text="Save the dungeon as a PNG"/></tooltip>
                </Button>
            </HBox>
        </Pane>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="4" right="10" bottom="4" left="10"/>
            </padding>
            <Label fx:id="statusLabel" text="Ready — pick a generator and click Generate."/>
        </HBox>
    </bottom>
</BorderPane>
