            <HBox fx:id="exportBox" spacing="8" alignment="CENTER_RIGHT" styleClass="exports"
                  managed="false" visible="false">
                <CheckBox fx:id="liveToggle" text="Live" onAction="#onLive">
                    <tooltip><Tooltip text="Bring the maze to life — same erosion ticks as the web"/></tooltip>
                </CheckBox>
                <CheckBox fx:id="hardToggle" text="Hard">
                    <tooltip><Tooltip text="Harden — close extra passages each Live tick (ADR-008)"/></tooltip>
                </CheckBox>
                <CheckBox fx:id="jamToggle" text="Jam" onAction="#onJam">
                    <tooltip><Tooltip text="Simulate traffic — walked cells bloom cost, then cool off"/></tooltip>
                </CheckBox>
                <CheckBox fx:id="allToggle" text="All" onAction="#onAll">
                    <tooltip><Tooltip text="Compare all solvers — overlapping routes are consensus"/></tooltip>
                </CheckBox>
                <Button fx:id="pngButton" text="PNG" onAction="#onExportPng">
                    <tooltip><Tooltip text="Save the dungeon as a PNG"/></tooltip>
                </Button>
            </HBox>
        </Pane>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="4" right="10" bottom="4" left="10"/>
            </padding>
            <Label fx:id="statusLabel" text="Ready — pick a generator and click Generate."/>
            <Label fx:id="worldLabel" text="world-zero · listening"/>
        </HBox>
    </bottom>
</BorderPane>
