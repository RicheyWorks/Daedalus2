<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<!--
    Main desktop layout. Three regions:

      - top:    compact toolbar (generator, grid, seed, Generate, solver)
      - center: canvas pane; legend overlays the well and does not steal height
      - bottom: status bar (last action + timing)

    Controller is wired by Spring (DaedalusPrimaryStage's controller factory).
    The canvas itself doesn't auto-resize — MainController sizes the
    backing store to the pane times the window output scale and redraws.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.daedalus.desktop.ui.MainController"
            styleClass="root">

    <top>
        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="toolbar">
            <padding>
                <Insets top="6" right="8" bottom="6" left="8"/>
            </padding>

            <Label text="DAEDALUS" styleClass="brand"/>
            <Separator orientation="VERTICAL"/>

            <ComboBox fx:id="generatorChoice" prefWidth="88" maxWidth="88">
                <tooltip><Tooltip text="Generator"/></tooltip>
            </ComboBox>

            <Spinner fx:id="rowsSpinner" prefWidth="58" editable="true">
                <tooltip><Tooltip text="Rows"/></tooltip>
            </Spinner>
            <Spinner fx:id="colsSpinner" prefWidth="58" editable="true">
                <tooltip><Tooltip text="Cols"/></tooltip>
            </Spinner>
            <Spinner fx:id="hotspotSpinner" prefWidth="46" editable="true">
                <tooltip><Tooltip text="Hot spots"/></tooltip>
            </Spinner>
            <Spinner fx:id="hotspotCostSpinner" prefWidth="50" editable="true">
                <tooltip><Tooltip text="Spot cost"/></tooltip>
            </Spinner>
            <ComboBox fx:id="braidChoice" prefWidth="56" maxWidth="56">
                <tooltip><Tooltip text="Braid"/></tooltip>
            </ComboBox>

            <Separator orientation="VERTICAL"/>

            <TextField fx:id="seedField" prefWidth="52" promptText="seed">
                <tooltip><Tooltip text="Seed (blank = random)"/></tooltip>
            </TextField>

            <Button fx:id="generateButton"
                    text="Generate"
                    defaultButton="true"
                    onAction="#onGenerate"/>

            <Separator orientation="VERTICAL"/>

            <ComboBox fx:id="solverChoice" prefWidth="80" maxWidth="80">
                <tooltip><Tooltip text="Solver"/></tooltip>
            </ComboBox>
            <Button fx:id="solveButton" text="Solve" onAction="#onSolve"/>
            <Button fx:id="resetButton" text="Reset" onAction="#onReset"/>
            <CheckBox fx:id="fogToggle" text="Fog" onAction="#onFog">
                <tooltip><Tooltip text="Fog of war — walk reveals the dungeon"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="heatToggle" text="Heat" onAction="#onHeat">
                <tooltip><Tooltip text="Distance from the goal"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="cutsToggle" text="Cuts" onAction="#onCuts">
                <tooltip><Tooltip text="Min-cut chokepoints and dead ends"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="hardestToggle" text="Long" onAction="#onHardest">
                <tooltip><Tooltip text="Hardest simple route"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="sanctuaryToggle" text="Safe" onAction="#onSanctuaries">
                <tooltip><Tooltip text="Sanctuaries — k-center safe points"/></tooltip>
            </CheckBox>
            <ComboBox fx:id="lensChoice" prefWidth="64" maxWidth="64" onAction="#onLens">
                <tooltip><Tooltip text="Heuristic lens — must / tie / never"/></tooltip>
            </ComboBox>
            <CheckBox fx:id="raceToggle" text="Race" onAction="#onRace">
                <tooltip><Tooltip text="Selected solver vs a rival, same arena as the web"/></tooltip>
            </CheckBox>
            <CheckBox fx:id="huntToggle" text="Hunt" onAction="#onHunt">
                <tooltip><Tooltip text="Waypoint hunt — collect the coins"/></tooltip>
            </CheckBox>
        </HBox>
    </top>

